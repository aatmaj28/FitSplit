GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Optional model overrides (defaults live in app/config.py)
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_THINKING_LEVEL=low   (minimal|low|medium|high; higher = slower, may hit the 30s timeout)
# CLAUDE_MODEL=claude-opus-5-5   (claude-fable-5-1 is faster; claude-sonnet-5-5 was the original spec)
# GROQ_MODEL=

# Optional provider order and Claude budget (defaults shown)
# VISION_CHAIN_ORDER=claude,gemini,groq   (floor plan labels, AI rent check)
# TEXT_CHAIN_ORDER=claude,groq,gemini     (clone conversations, house rules)
# CLAUDE_CALL_CAP=250                     (hard cap on Claude calls in data/llm/usage.json)
